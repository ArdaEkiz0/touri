{
  "name": "touri-desktop",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/contracts",
    "sidecar",
    "ui"
  ],
  "scripts": {
    "typecheck": "bunx tsc --noEmit -p tsconfig.base.json",
    "test": "bun test sidecar/test",
    "lint": "bunx biome check .",
    "icons:generate": "bun scripts/gen-icons.ts",
    "build:sidecar": "bun build --compile --target=bun-darwin-arm64 sidecar/src/main.ts --outfile src-tauri/binaries/touri-sidecar-aarch64-apple-darwin",
    "tauri": "bunx tauri",
    "build:cli": "bun scripts/build-cli.ts",
    "touri": "bun sidecar/src/cli/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  }
}
